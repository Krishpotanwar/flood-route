# Optional API origin. Leave empty for same-origin /v1 requests.
# Vite development and preview proxy /v1 to http://127.0.0.1:8080.
# Override the local target with FLOODROUTE_DEV_API_URL in the server environment.
# Set this before building when the production API has a separate origin.
# Example: VITE_API_BASE_URL=https://api.example.com
# VITE_ variables are public; do not put secrets here.
VITE_API_BASE_URL=
